// portier — CLI entry point and command routing.

func app_version() (v) { v = "0.2.0" }

func resolve_port(a) (port) {
    p := opt(a, "-port", env("PORT"))
    if p == "" { p = "8797" }
    port = parse_int(p)
}

func main() {
    a := args()
    cmd := "help"
    if len(a) > 1 { cmd = a[1] }

    if cmd == "serve" {
        run_server(resolve_port(a))
    } else if cmd == "app-new" {
        cmd_app_new(a)
    } else if cmd == "apps" {
        cmd_apps(a)
    } else if cmd == "stats" {
        cmd_stats()
    } else if cmd == "guide" {
        base := env("PORTIER_PUBLIC_URL")
        if base == "" { base = "http://localhost:8797" }
        println(guide_json(base))
    } else if cmd == "feedback" {
        cmd_feedback(a)
    } else if cmd == "version" {
        out_ok("{\"version\":\"" + app_version() + "\"}")
    } else if cmd == "help-json" {
        println(help_json())
    } else if cmd == "help" || cmd == "--help" || cmd == "-h" {
        println(help_text())
    } else {
        // An unknown verb is an INPUT ERROR, not a success. This printed the
        // help text to stdout and exited 0, so an agent that mistyped a verb got
        // a help page on the channel reserved for data and a status saying the
        // run had worked — indistinguishable from success.
        //
        // stderr + exit 80 (cli-output-spec: 80-89 = input/validation). Caught by
        // the scheduled install sweep the day this binary was first published.
        write(2, "{\"ok\":false,\"error\":{\"type\":\"input\",\"message\":\"unknown command: " + cmd + "\",\"recoverable\":true,\"suggestions\":[\"portier help\"]}}\n")
        println(help_text())
        exit(80)
    }
}
